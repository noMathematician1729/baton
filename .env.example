# Local app
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:4000

# SQLite service-payment ledger metadata; relative to the server directory.
# The database file is local and ignored by Git. It does not store task artifacts.
PAYMENT_LEDGER_PATH=./data/payment-ledger.sqlite

# Ethereum Sepolia: escrow and live ENS job-authority checks
SEPOLIA_RPC_URL=
# Optional comma-separated witness RPCs; authority reads fail closed on provider disagreement.
SEPOLIA_RPC_BACKUP_URLS=
SEPOLIA_CHAIN_ID=11155111
GATEWAY_AUTHORITY_MODE=auto
BATON_ESCROW_ADDRESS=
BATON_REWARD_TOKEN_ADDRESS=
ENS_JOB_NAME=
# Actual resolver returned for ENS_JOB_NAME on Sepolia (not the BATON adapter).
ENS_RESOLVER_ADDRESS=
# BATON JobAuthority adapter deployed with ENS_RESOLVER_ADDRESS as its constructor argument.
BATON_AUTHORITY_ADAPTER_ADDRESS=
# Deployment-only key. Use a throwaway, testnet-funded account.
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Optional buyer signer for local, buyer-signed checkpoint-key grants; it must match the job buyer.
BATON_BUYER_EVM_PRIVATE_KEY=

# Arkiv Rabdi testnet: encrypted checkpoints and all task artifacts
ARKIV_NETWORK=rabdi
ARKIV_RPC_URL=
ARKIV_ACCESS_KEY=
# Arkiv entity-owner signer. Use a buyer-controlled account for recovery and renewal.
ARKIV_SIGNER_PRIVATE_KEY=
# Per-worker Sepolia signer for offers and acknowledgements. Keep worker keys separate.
WORKER_EVM_PRIVATE_KEY=
# Public worker addresses used by the Sepolia authority acceptance workflow.
WORKER_A_ADDRESS=
WORKER_B_ADDRESS=
# Worker A signer for the Sepolia escrow lifecycle demo. Store only in ignored local .env.
WORKER_A_EVM_PRIVATE_KEY=

# Checkpoint encryption; use a random 32-byte key encoded as 64 hex characters.
# This raw key is for local development only; production should use buyer-controlled key access.
CHECKPOINT_ENCRYPTION_KEY=
CHECKPOINT_KEY_ID=local-dev
CHECKPOINT_KEY_SERVICE_URL=
# Worker-specific service tokens and X25519 decryption keys live in ignored
# .env.worker-a / .env.worker-b files; never share them between workers.
CHECKPOINT_KEY_SERVICE_TOKEN=
CHECKPOINT_KEY_SERVICE_DECRYPTION_PRIVATE_KEY=
# Buyer-host key-service settings live in ignored .env.key-service.
CHECKPOINT_KEY_SERVICE_HOST=127.0.0.1
CHECKPOINT_KEY_SERVICE_PORT=4411
CHECKPOINT_KEY_SERVICE_DATABASE_PATH=.baton-data/checkpoint-key-service.sqlite
CHECKPOINT_KEY_SERVICE_STORAGE_KEY=

# Hedera x402 buyer gateway. Keep this payer key on the server only.
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Hedera network history API (not a BATON task-content mirror).
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
X402_FACILITATOR_URL=
X402_NETWORK=hedera:testnet

# Optional operational settings
LOG_LEVEL=info

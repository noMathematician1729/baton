# Worker B clean-host recovery configuration. Copy to ignored .env.worker-b and fill locally.
BATON_API_URL=http://127.0.0.1:4000
SEPOLIA_RPC_URL=
SEPOLIA_RPC_BACKUP_URLS=
SEPOLIA_CHAIN_ID=11155111
CONFIRMATION_BLOCKS=2
BATON_ESCROW_ADDRESS=
BATON_AUTHORITY_ADAPTER_ADDRESS=
WORKER_ADDRESS=
WORKER_EVM_PRIVATE_KEY=

# Read-only Arkiv access; B does not need the buyer's Arkiv signing key.
ARKIV_RPC_URL=
ARKIV_ACCESS_KEY=
ARKIV_STORAGE_OWNER_ADDRESS=

# B's own scoped key-service credentials.
CHECKPOINT_KEY_SERVICE_URL=
CHECKPOINT_KEY_SERVICE_TOKEN=
CHECKPOINT_KEY_SERVICE_DECRYPTION_PRIVATE_KEY=

# B-specific MCP access; keep the bearer token in this file only.
MCP_SERVER_URL=
MCP_API_KEY=
# First run `npm run worker:tools:b` to inspect the server/tool schemas.
MCP_EXPECTED_SERVER_ID=
MCP_PROBE_TOOL_NAME=
MCP_PROBE_SCHEMA_VERSION=
MCP_PROBE_SCHEMA_DIGEST=
# Use a documented, read-only fixture input and its expected output digest.
MCP_PROBE_INPUT_JSON=
MCP_PROBE_EXPECTED_OUTPUT_DIGEST=
MCP_PROBE_TIMEOUT_MS=15000

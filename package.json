{
  "name": "baton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server",
    "demo:local": "npm run demo:local --workspace=server",
    "tools:mcp": "npm run tools:stdio --workspace=server",
    "status:refresh": "npm run status:refresh --workspace=server",
    "test": "npm run test:checkpoint --workspace=server && npm run test:storage --workspace=server && npm run test:runtime --workspace=server && npm run test:worker --workspace=server && npm run test:tools --workspace=server && npm run test:admission --workspace=server && npm run test:ledger --workspace=server && npm run test:api --workspace=server",
    "test:local": "npm run build --workspace=server && node scripts/acceptance-local.mjs",
    "test:signing": "npm run build --workspace=server && node scripts/check-signing-vector.mjs",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "deploy:sepolia:escrow": "npm run contracts:compile && node scripts/deploy-escrow.mjs",
    "deploy:sepolia:escrow:replace": "npm run contracts:compile && node scripts/deploy-escrow.mjs --replace-existing",
    "test:sepolia:authority": "npm run contracts:compile && node scripts/test-ens-authority-sepolia.mjs",
    "test:sepolia:worker-grants": "npm run contracts:compile && node scripts/test-worker-ens-grants-sepolia.mjs",
    "demo:sepolia:job-lifecycle": "npm run contracts:compile && node scripts/demo-sepolia-job-lifecycle.mjs",
    "key-service:provision": "node --import tsx scripts/key-service/provision.mjs",
    "key-service:grant": "node --import tsx scripts/key-service/grant.mjs",
    "key-service:smoke": "node --import tsx scripts/key-service/smoke.mjs",
    "key-service:start": "npm run build --workspace=server && node --env-file=.env.key-service server/dist/src/services/key-service/index.js",
    "key-service:tunnel": "cloudflared tunnel --no-autoupdate --url http://127.0.0.1:4411",
    "key-service:set-url": "node scripts/key-service/set-url.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run contracts:compile && npm run test:signing && npm run test:local"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}

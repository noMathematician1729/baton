{
  "name": "@baton/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:local": "tsx apps/worker/src/cli.ts demo-local",
    "status:refresh": "tsx ../scripts/status/refresh.ts",
    "tools:stdio": "tsx services/tools/stdio.ts",
    "test:worker": "tsx --test apps/worker/src/localDemo.test.ts",
    "test:checkpoint": "tsx --test packages/checkpoint/src/index.test.ts",
    "test:storage": "tsx --test packages/storage/src/arkiv.test.ts",
    "test:runtime": "tsx --test packages/runtime/src/index.test.ts",
    "test:tools": "tsx --test services/tools/index.test.ts",
    "test:admission": "tsx --test services/admission/index.test.ts",
    "test:authority": "node --import tsx --test src/chain/*.test.ts",
    "test:ledger": "tsx --test src/services/ledger/*.test.ts",
    "test:api": "tsx --test src/app.integration.test.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@ensdomains/ensjs": "^5.2.12",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@x402/core": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "@x402/hedera": "^2.30.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "solc": "^0.8.28",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
